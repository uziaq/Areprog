# ============================================================
#  AREPROG — Netlify _redirects
#  À placer à la RACINE du repo
# ============================================================

# ── Fichiers internes servis par la racine du dépôt (publish=".") ─────
#    Code source des fonctions, docs et config : jamais exposés au public.
#    Le « ! » force la règle même si le fichier existe sur le disque.
/netlify/*                          /404.html                           404!
/CLAUDE.md                          /404.html                           404!
/SETUP.md                           /404.html                           404!
/AUDIT.md                           /404.html                           404!
/package.json                       /404.html                           404!
/package-lock.json                  /404.html                           404!
/netlify.toml                       /404.html                           404!

# ── Serveur MCP (connecteur Claude) + OAuth — netlify/function/mcp ─────
/.well-known/oauth-protected-resource      /.netlify/functions/mcp/prm         200!
/.well-known/oauth-protected-resource/*    /.netlify/functions/mcp/prm         200!
/.well-known/oauth-authorization-server    /.netlify/functions/mcp/asm         200!
/.well-known/oauth-authorization-server/*  /.netlify/functions/mcp/asm         200!
/mcp                                       /.netlify/functions/mcp             200!
/mcp/*                                     /.netlify/functions/mcp/:splat      200!

# ── Admin (anciennement Netlify Identity — migré vers Firebase Auth) ─────
/admin                              /gestion.html                       301
/perf                                /perf.html                          200

