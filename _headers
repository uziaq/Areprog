# ============================================================
#  AREPROG — Netlify _headers
# ============================================================

# ── Sécurité globale + CSP du site public ───────────────────
#    Un seul bloc /* : deux blocs séparés se fusionnaient de façon fragile.
#    X-XSS-Protection est volontairement absent (obsolète, déconseillé).
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://*.googleapis.com https://*.gstatic.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.netlify.com https://*.netlify.app https://*.googleapis.com https://*.gstatic.com https://www.gstatic.com; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

# ── CSP pour le simulateur (iframe OLSX) ────────────────────
#    Netlify applique les headers sur l'URL demandée, pas sur l'URL réécrite :
#    /simulateur.html doit donc porter la même règle que /simulateur.
/simulateur
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://api.olsx.eu https://*.googleapis.com https://*.gstatic.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.olsx.eu https://*.netlify.com https://*.netlify.app https://*.googleapis.com https://*.gstatic.com https://www.gstatic.com; frame-src https://api.olsx.eu; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

/simulateur.html
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://api.olsx.eu https://*.googleapis.com https://*.gstatic.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.olsx.eu https://*.netlify.com https://*.netlify.app https://*.googleapis.com https://*.gstatic.com https://www.gstatic.com; frame-src https://api.olsx.eu; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

